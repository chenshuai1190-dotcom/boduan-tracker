# Frontend Supabase client. These values are public by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only quote proxy secret. Never expose this with a VITE_ prefix.
EODHD_API_KEY=your_rotated_eodhd_api_key

# Optional SEC fair-access identity used by the server-side official earnings reader.
# Prefer an app name plus a monitored contact email; never expose this with a VITE_ prefix.
SEC_USER_AGENT=BoduanTracker/1.0 admin@example.com

# Quote API hardening.
# Default behavior requires a valid Supabase user session.
QUOTE_API_AUTH_REQUIRED=true

# Optional comma-separated browser origins allowed to call /api/quote.
# Include preview domains only when you intentionally want them enabled.
QUOTE_ALLOWED_ORIGINS=https://boduan-tracker.vercel.app
