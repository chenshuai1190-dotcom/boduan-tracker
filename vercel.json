{
  "rewrites": [
    {
      "source": "/api/earnings-detail",
      "destination": "/api/earnings-calendar?operation=detail"
    },
    {
      "source": "/api/earnings-growth",
      "destination": "/api/earnings-calendar?operation=growth"
    },
    {
      "source": "/api/close-snapshot-schedule",
      "destination": "/api/pnl-report-daily-snapshot?operation=close-snapshot-schedule"
    },
    {
      "source": "/api/close-snapshot-schedule-retry",
      "destination": "/api/pnl-report-daily-snapshot?operation=close-snapshot-schedule"
    },
    {
      "source": "/api/close-snapshot-schedule-late-retry",
      "destination": "/api/pnl-report-daily-snapshot?operation=close-snapshot-schedule&recoverLatestCompleted=1"
    },
    {
      "source": "/api/community-competition-daily-snapshot",
      "destination": "/api/community-competition?operation=daily-snapshot"
    },
    {
      "source": "/api/pnl-report-daily-snapshot-retry",
      "destination": "/api/pnl-report-daily-snapshot"
    },
    {
      "source": "/api/pnl-report-daily-snapshot-late-retry",
      "destination": "/api/pnl-report-daily-snapshot"
    },
    {
      "source": "/api/community-competition-daily-snapshot-retry",
      "destination": "/api/community-competition?operation=daily-snapshot"
    },
    {
      "source": "/api/community-competition-daily-snapshot-late-retry",
      "destination": "/api/community-competition?operation=daily-snapshot"
    }
  ],
  "crons": [
    {
      "path": "/api/close-snapshot-schedule",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/close-snapshot-schedule-retry",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/close-snapshot-schedule-late-retry",
      "schedule": "0 23 * * 1-5"
    }
  ]
}
