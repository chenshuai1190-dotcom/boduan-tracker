{
  "rewrites": [
    {
      "source": "/api/community-competition-daily-snapshot",
      "destination": "/api/community-competition?operation=daily-snapshot"
    },
    {
      "source": "/api/pnl-report-daily-snapshot-retry",
      "destination": "/api/pnl-report-daily-snapshot"
    },
    {
      "source": "/api/pnl-report-daily-snapshot-late-retry",
      "destination": "/api/pnl-report-daily-snapshot"
    },
    {
      "source": "/api/community-competition-daily-snapshot-retry",
      "destination": "/api/community-competition?operation=daily-snapshot"
    },
    {
      "source": "/api/community-competition-daily-snapshot-late-retry",
      "destination": "/api/community-competition?operation=daily-snapshot"
    }
  ],
  "crons": [
    {
      "path": "/api/pnl-report-daily-snapshot",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/community-competition-daily-snapshot",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/pnl-report-daily-snapshot-retry",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/community-competition-daily-snapshot-retry",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/pnl-report-daily-snapshot-late-retry",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/community-competition-daily-snapshot-late-retry",
      "schedule": "0 23 * * 1-5"
    }
  ]
}
